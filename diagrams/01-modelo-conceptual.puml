@startuml
title Modelo Conceptual del Dominio

class Paciente {
    +idPaciente : UUID
    +nombre : String
    +correo : String
    +telefono : String
}

class Medico {
    +idMedico : UUID
    +nombre : String
    +especialidad : String
}

class Cita {
    +idCita : UUID
    +fechaHora : DateTime
    +estado : String
}

class HistoriaClinica {
    +idHistoria : UUID
    +fechaCreacion : Date
}

class Diagnostico {
    +descripcion : String
}

class Tratamiento {
    +descripcion : String
}

class ExamenLaboratorio {
    +tipoExamen : String
}

class ResultadoLaboratorio {
    +resultado : String
}

Paciente "1" -- "0..*" Cita
Medico "1" -- "0..*" Cita

Paciente "1" -- "1" HistoriaClinica

HistoriaClinica "1" -- "0..*" Diagnostico
HistoriaClinica "1" -- "0..*" Tratamiento
HistoriaClinica "1" -- "0..*" ExamenLaboratorio

ExamenLaboratorio "1" -- "1" ResultadoLaboratorio

@enduml